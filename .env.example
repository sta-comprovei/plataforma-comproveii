# ============================================================
# TNS Gestão de Entregas — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no Git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY

# ── Anthropic (Assistente IA) ─────────────────────────────────
# A ANTHROPIC_API_KEY é configurada como secret do Supabase, NÃO como variável de ambiente do Netlify.
# Configure via: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Nunca exponha a chave no frontend.
